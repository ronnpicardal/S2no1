
#include <iostream>
using namespace std;

int main()
{
    float num1, num2;
    char op;

    cout << "Enter two numbers: ";
    cin >> num1 >> num2;

    cout << "\nEnter the operator(+, -, *, /): ";
    cin >> op;

    switch (op)
    {
        case '+':
            cout << "\n\nThe result of the operation is : " << num1 + num2;
            break;

        case '-':
            cout << "\n\nThe result of the operation is : " << num1 - num2;
            break;

        case '*':
            cout << "\n\nThe result of the operation is : " << num1 * num2;
            break;

        case '/':
            if (num2 != 0)
            {
                cout << "\n\nThe result of the operation is : " << num1 / num2;
            }
            else
            {
                cout << "\n\nCannot divide by zero.";
            }
            break;

        default:
            cout << "\n\nInvalid operator.";
    }

    return 0;
}
