
#include <iostream>
using namespace std;

int main()
{
    int number;

    cout << "Enter a number (up to 4 digits): ";
    cin >> number;

    if (number <= 0)
    {
        cout << "It is a non-positive number.";
    }
    else if (number <= 9)
    {
        cout << "It is a positive number with 1 digit.";
    }
    else if (number <= 99)
    {
        cout << "It is a positive number with 2 digits.";
    }
    else if (number <= 999)
    {
        cout << "It is a positive number with 3 digits.";
    }
    else if (number <= 9999)
    {
        cout << "It is a positive number with 4 digits.";
    }
    else
    {
        cout << "Please enter a number with no more than 4 digits.";
    }

    return 0;
}
